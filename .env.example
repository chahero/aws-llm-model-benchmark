# AWS Credentials
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Optional: AWS Session Token (for temporary credentials)
# AWS_SESSION_TOKEN=your_session_token_here

# Optional: AWS Profile (if using named profiles)
# AWS_PROFILE=default

# ===========================================
# Model Configuration
# ===========================================

# Model IDs (customize if needed)
MODEL_ID_NOVA_LITE=us.amazon.nova-lite-v1:0
MODEL_ID_NOVA_PRO=us.amazon.nova-pro-v1:0
MODEL_ID_NOVA_2_LITE=us.amazon.nova-2-lite-v1:0
MODEL_ID_CLAUDE_SONNET_4_5=global.anthropic.claude-sonnet-4-5-20250929-v1:0

# Disable specific models (comma-separated)
# Example: DISABLED_MODELS=nova-2-lite,claude-sonnet-4-5
DISABLED_MODELS=

# ===========================================
# Benchmark Configuration
# ===========================================

# Models to benchmark (comma-separated)
# Available: nova-lite, nova-pro, nova-2-lite, claude-sonnet-4-5
# Use "all" to test all models
BENCHMARK_MODELS=nova-lite,nova-pro,nova-2-lite,claude-sonnet-4-5

# Benchmarks to run (comma-separated)
# Available: kobest, klue, haerae
# Use "all" to run all benchmarks
BENCHMARK_TASKS=kobest,klue,haerae

# Maximum examples per task (leave empty for full dataset)
# Useful for testing: set to 10-100
BENCHMARK_SAMPLE_LIMIT=

# API rate limit (requests per second)
BENCHMARK_RATE_LIMIT=10.0

# ===========================================
# Data Configuration
# ===========================================

# HuggingFace Token (get from https://huggingface.co/settings/tokens)
# Required to avoid rate limiting when downloading datasets
HF_TOKEN=your_huggingface_token_here

# HuggingFace datasets cache directory (relative to project root)
HF_DATASETS_CACHE=./data/datasets
